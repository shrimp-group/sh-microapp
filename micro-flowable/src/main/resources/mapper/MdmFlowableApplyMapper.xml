<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wkclz.micro.flowable.mapper.MdmFlowableApplyMapper">

    <select id="getApplyPage"
            parameterType="com.wkclz.micro.flowable.bean.entity.MdmFlowableApply"
            resultType="com.wkclz.micro.flowable.bean.entity.MdmFlowableApply">
        SELECT * FROM mdm_flowable_apply
        WHERE deleted = 0
        <if test="designCode != null and designCode != ''">
            AND design_code = #{designCode}
        </if>
        <if test="businessType != null and businessType != ''">
            AND business_type = #{businessType}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="startUserId != null and startUserId != ''">
            AND start_user_id = #{startUserId}
        </if>
        <if test="tenantCode != null and tenantCode != ''">
            AND tenant_code = #{tenantCode}
        </if>
        ORDER BY id DESC
    </select>

</mapper>
