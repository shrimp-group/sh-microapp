<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wkclz.framework</groupId>
        <artifactId>sh-parent</artifactId>
        <version>5.0.1-SNAPSHOT</version>
    </parent>

    <groupId>com.wkclz.microapp</groupId>
    <artifactId>sh-microapp</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>sh-microapp</name>

    <properties>
        <revision>5.0.1-SNAPSHOT</revision>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 三方依赖版本收口：未入 sh-bom 的版本在此集中管理（sh-bom 下沉后可迁移删除） -->
        <graalvm-polyglot.version>25.0.1</graalvm-polyglot.version>
        <easyexcel.version>3.1.1</easyexcel.version>
        <jsqlparser.version>4.9</jsqlparser.version>
        <flying-saucer-pdf.version>9.7.2</flying-saucer-pdf.version>
        <wiremock.version>3.13.1</wiremock.version>
        <qlexpress.version>3.3.4</qlexpress.version>
        <!-- 命名避开 spring-boot-dependencies 内部属性 groovy.version（当前 5.0.5） -->
        <codehaus-groovy.version>3.0.9</codehaus-groovy.version>
        <flowable.version>8.0.0</flowable.version>
        <liteflow.version>2.16.3.1</liteflow.version>
    </properties>

    <modules>
        <module>micro-audit</module>
        <module>micro-dict</module>
        <module>micro-fileos</module>
        <module>micro-liteflow</module>
        <module>micro-form</module>
        <module>micro-fun</module>
        <module>micro-k8s</module>
        <module>micro-mask</module>
        <module>micro-material</module>
        <module>micro-msg</module>
        <module>micro-pdf</module>
        <module>micro-points</module>
        <module>micro-pay</module>
        <module>micro-rmcheck</module>
        <module>micro-seq</module>
        <module>micro-flowable</module>
        <module>micro-wxapp</module>
        <module>micro-wxmp</module>
        <module>micro-report</module>
        <module>micro-autotest</module>
        <module>micro-dbview</module>
        <module>micro-dag</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>com.wkclz.framework</groupId>
            <artifactId>sh-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wkclz.framework</groupId>
            <artifactId>sh-web</artifactId>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- 本工程模块统一登记（groupId com.wkclz.microapp），模块间依赖免写版本 -->
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-audit</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-dict</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-fileos</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-liteflow</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-form</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-fun</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-k8s</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-mask</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-material</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-msg</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-pdf</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-points</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-pay</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-rmcheck</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-seq</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-flowable</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-wxapp</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-wxmp</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-report</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-autotest</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-dbview</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.wkclz.microapp</groupId>
                <artifactId>micro-dag</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- 三方依赖版本收口（对应各模块原硬编码版本） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>${jsqlparser.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xhtmlrenderer</groupId>
                <artifactId>flying-saucer-pdf-itext5</artifactId>
                <version>${flying-saucer-pdf.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>QLExpress</artifactId>
                <version>${qlexpress.version}</version>
            </dependency>
            <dependency>
                <groupId>org.codehaus.groovy</groupId>
                <artifactId>groovy</artifactId>
                <version>${codehaus-groovy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flowable</groupId>
                <artifactId>flowable-bpmn-model</artifactId>
                <version>${flowable.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flowable</groupId>
                <artifactId>flowable-bpmn-converter</artifactId>
                <version>${flowable.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yomahub</groupId>
                <artifactId>liteflow-spring-boot-starter</artifactId>
                <version>${liteflow.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yomahub</groupId>
                <artifactId>liteflow-rule-sql</artifactId>
                <version>${liteflow.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yomahub</groupId>
                <artifactId>liteflow-script-groovy</artifactId>
                <version>${liteflow.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yomahub</groupId>
                <artifactId>liteflow-script-javax</artifactId>
                <version>${liteflow.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yomahub</groupId>
                <artifactId>liteflow-script-aviator</artifactId>
                <version>${liteflow.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 质量门禁 lint：规则见 config/checkstyle.xml，子模块无需重复配置 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>3.6.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>14.4.0</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                        <consoleOutput>true</consoleOutput>
                        <failOnViolation>true</failOnViolation>
                        <violationSeverity>error</violationSeverity>
                    </configuration>
                </plugin>
                <!-- 覆盖率报告：先出报告不设阈值，待测试补齐后再启用 80% check -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.16</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <executions>
                    <execution>
                        <id>lint</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
