<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wkclz.micro.form.mapper.MdmFormRuleFieldMapper">
      
    <select id="get4Cache" resultType="com.wkclz.micro.form.bean.dto.MdmFormRuleFieldDto">
        SELECT
            form_rule_code,
            field_code,
            field_name
        FROM
            mdm_form_rule_field
        WHERE
            deleted = 0
        ORDER BY
            sort ASC,
            id ASC;
  </select>
    
</mapper>

