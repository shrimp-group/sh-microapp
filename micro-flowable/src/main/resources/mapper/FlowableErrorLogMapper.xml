<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wkclz.micro.flowable.mapper.FlowableErrorLogMapper">

    <select id="getErrorLogPage"
            parameterType="com.wkclz.micro.flowable.bean.entity.FlowableErrorLog"
            resultType="com.wkclz.micro.flowable.bean.entity.FlowableErrorLog">
        SELECT
            *
        FROM
            flowable_error_log
        WHERE
            deleted = 0
            <if test="errorType != null"> AND error_type = #{errorType} </if>
            <if test="handleStatus != null"> AND handle_status = #{handleStatus} </if>
            <if test="procInsId != null"> AND proc_ins_id = #{procInsId} </if>
            <if test="tenantCode != null"> AND tenant_code = #{tenantCode} </if>
        ORDER BY
            occur_time DESC
    </select>

</mapper>
