<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wkclz.micro.flowable.mapper.FlowableCategoryMapper">

    <select id="getCategoryPage"
            parameterType="com.wkclz.micro.flowable.bean.entity.FlowableCategory"
            resultType="com.wkclz.micro.flowable.bean.entity.FlowableCategory">
        SELECT * FROM flowable_category
        WHERE deleted = 0
        <if test="categoryCode != null and categoryCode != ''">
            AND category_code LIKE CONCAT('%', #{categoryCode}, '%')
        </if>
        <if test="categoryName != null and categoryName != ''">
            AND category_name LIKE CONCAT('%', #{categoryName}, '%')
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="tenantCode != null and tenantCode != ''">
            AND tenant_code = #{tenantCode}
        </if>
        ORDER BY sort, id DESC
    </select>

    <select id="getCategoryList"
            parameterType="com.wkclz.micro.flowable.bean.entity.FlowableCategory"
            resultType="com.wkclz.micro.flowable.bean.entity.FlowableCategory">
        SELECT * FROM flowable_category
        WHERE deleted = 0
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="tenantCode != null and tenantCode != ''">
            AND tenant_code = #{tenantCode}
        </if>
        ORDER BY sort, id ASC
    </select>

</mapper>
